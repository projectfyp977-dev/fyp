# Copy to .env and fill in values before running Docker Compose
# Development: docker compose -f docker-compose.dev.yml up
# Production:  docker compose -f docker-compose.prod.yml up
# Live domain: atscvmaker.online

# Database (required for both)
DB_HOST=mysql
DB_USER=root
DB_PASSWORD=your-secure-password
DB_NAME=voice_cv_maker

# Auth (required for production)
JWT_SECRET=your-secret-key-min-32-chars

# AI (optional - for OpenAI features)
OPENAI_API_KEY=

# Client API URL (production only - use /api when served behind nginx)
REACT_APP_API_URL=/api
